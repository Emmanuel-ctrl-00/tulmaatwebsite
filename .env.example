# Copy this file to .env for local development and fill in real values.
# In production (Render), set these as Environment Variables in the
# dashboard instead of committing a .env file.

# Generate a fresh one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Never True in production
DJANGO_DEBUG=False

# Comma-separated list, e.g. tulmaatwebsiteg.onrender.com,www.tulmaathotel.com
DJANGO_ALLOWED_HOSTS=tulmaatwebsiteg.onrender.com

# Email (booking confirmations). Example using a Gmail App Password:
# https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tulmaat Hotel <no-reply@tulmaathotel.com>

# Database. Leave blank to use local SQLite (fine for development).
# On Render, set this to the "Internal Database URL" from your Render
# Postgres instance — required for data to survive redeploys.
DATABASE_URL=

# Used by `python manage.py ensure_superuser` to (re)create your admin
# account if one doesn't exist yet. Safe to leave set permanently.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
